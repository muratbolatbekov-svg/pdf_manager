# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (optional — SQLite used if not set)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Cloudinary — use either CLOUDINARY_URL or all three variables below
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: unsigned upload preset from Cloudinary Dashboard
# CLOUDINARY_UPLOAD_PRESET=your-preset-name
# CLOUDINARY_UPLOAD_RESOURCE_TYPE=auto

# Email notifications (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com
# NOTIFY_EMAIL=admin@example.com
# APP_URL=https://your-app.up.railway.app
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Cron (09:00 Asia/Almaty): python manage.py send_expiry_notifications
# Railway Cron schedule (UTC): 0 4 * * *

# Admin bootstrap (optional — runs on each deploy if set)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Production
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
