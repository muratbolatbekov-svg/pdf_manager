# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — PostgreSQL via DATABASE_URL (Railway sets this automatically when linked)
# Local dev falls back to SQLite if DATABASE_URL is not set
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Backblaze B2 (S3-compatible API)
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
# Optional: override region (auto-detected from endpoint if omitted)
# B2_REGION=us-east-005
# Optional: signed URLs for private buckets (default True)
# B2_QUERYSTRING_AUTH=True
# B2_URL_EXPIRE=604800

# Email notifications (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com
# NOTIFY_EMAIL=admin@example.com
# APP_URL=https://your-app.up.railway.app
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Cron (09:00 Asia/Almaty): python manage.py send_expiry_notifications
# Railway Cron schedule (UTC): 0 4 * * *

# Admin bootstrap (optional — runs on each deploy if set)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Production
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
